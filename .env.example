# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ===== Pi Agent Harness /agent 试点（源码开发模式，默认关闭）=====
# 仅支持 openai_compat profile；要求 Node >=22.19。Docker/桌面安装包当前不携带 Node。
# 启用前：cd pi-agent-worker && npm ci --ignore-scripts
AGENT_RUNTIME=python              # python | pi
AGENT_PI_NODE_COMMAND=node
# 留空时使用仓库根 pi-agent-worker/src/worker.js；显式无效路径会 fail-closed。
AGENT_PI_WORKER_PATH=
AGENT_PI_READY_TIMEOUT_S=10
# 每次等待模型事件的无输出超时（秒）；流式输出或工具往返会刷新计时。
AGENT_PI_RESPONSE_TIMEOUT_S=90
# Pi worker 不继承 HTTP(S)_PROXY；试点环境需可直连 AI_BASE_URL。

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=

# Optional Docker build extras. Set to legacy-cpu on older VPS hosts
# without AVX2/FMA support.
BACKEND_EXTRAS=

# ===== Data =====
# 运行时数据（enriched 分区 / 财务 / 自选 / 回测等）。
# 默认项目根 data/；内置 SSD 空间紧张时可指向外置盘：
# DATA_DIR=/Volumes/WD1/tickflow-data
DATA_DIR=./data

# ===== fhold CLI (optional) =====
# 默认优先同级 ../fhold/fhold-cli（开发工作区）；Journal 导入要求它支持 tx snapshot（仅本地模式）。
# 设置后必须是可执行路径；显式但无效的值会 fail-closed，不回退。
# FHOLD_CLI=/absolute/path/to/fhold-cli


# ===== Local market-data snapshots (optional overrides) =====
FQUANT_SNAPSHOT_ROOT_FSTORE_EXTENDED=/Volumes/WD1/duckdb/snapshots/fstore-extended
FQUANT_SNAPSHOT_ROOT_ENGINE_A_MONEYFLOW_MINUTE=/Volumes/WD1/duckdb/snapshots/engine-a-moneyflow-minute
FQUANT_SNAPSHOT_ROOT_ENGINE_A_CALLAUCTION=/Volumes/WD1/duckdb/snapshots/engine-a-callauction
# Generated by the Data-page canonical-history backfill; never stored in DATA_DIR.
TICKFLOW_CANONICAL_HISTORY_ROOT=/Volumes/WD1/duckdb/snapshots/tickflow-canonical-history